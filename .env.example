# Copia este archivo como .env para configurar el proyecto en local.
# Vacío usa SQLite en backend/todos.db. Para PostgreSQL, pega la URL de tu base de desarrollo.
# Ejemplo de formato: postgresql://USUARIO:CONTRASENA@HOST/NOMBRE_BD?sslmode=require
DATABASE_URL=

# Ruta opcional para usar otro archivo SQLite.
# TODO_DB_PATH=backend/todos.db

# Dirección de FastAPI en el desarrollo local.
TODO_API_URL=http://127.0.0.1:8000

# Solo si Flask está detrás de un proxy que sirve un dominio público.
# TODO_PUBLIC_URL=https://tareas.example.com
